<%- include('../cabecalho')%>


    <div>
        <tr><a href="../paleontologo"> ← Voltar </a></tr>
        <h3>Novo Paleontólogo</h3>


        <form method="post">
            <p>Nome</p>
            <input name="nome" type="text" placeholder="Nome do Paleontólogo">
            <br>
            <p>Nascimento</p>
            <input name="nascimento" type="number" value="2026">
            <br>
            <p>Descoberta</p>
            <input name="descoberta" type="text" placeholder="Espécies, Dinossauros, etc...">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>